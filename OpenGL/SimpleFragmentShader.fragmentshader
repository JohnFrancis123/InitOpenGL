#version 330

in vec3 retColor; 
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D sampler1;
uniform sampler2D sampler2;

uniform vec3 yuvSliders; 
uniform bool inverted;

void main()
{
 	//nlending the textures
 	vec4 tex1 = texture(sampler1, retTexCoord);
 	vec4 tex2 = texture(sampler2, retTexCoord);
	vec4 baseColor = mix(texture(sampler1, retTexCoord), texture(sampler2, retTexCoord), 0.5);

	//multiplying by our ret colors for rainbow effect
	baseColor.r *= retColor.r;
	baseColor.g *= retColor.g;
	baseColor.b *= retColor.b;

	//converting rgb to yuv
	vec3 rgb = baseColor.rgb;
 	float Y = 0.299 * rgb.r + 0.587 * rgb.g + 0.114 * rgb.b;
	float U = -0.14713 * rgb.r - 0.28886 * rgb.g + 0.436 * rgb.b;
	float V = 0.615 * rgb.r - 0.51499 * rgb.g - 0.10001 * rgb.b;

	//multiplying our values byt he slider values
	Y *= yuvSliders.r;
 	U *= yuvSliders.g;
 	V *= yuvSliders.b;

	//converting back to rgb
 	float r = Y + 1.13983 * V;
	float g = Y - 0.39465 * U - 0.58060 * V;
	float b = Y + 2.03211 * U;

 	vec3 newRGB = clamp(vec3(r, g, b), 0.0, 1.0);

	if (inverted)
	{
	    newRGB = vec3(1.0) - newRGB;
	}

    //newRGB *= retColor;
    FragColor = vec4(newRGB, 1.0);
}