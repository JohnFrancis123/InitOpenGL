#version 330

in vec3 retColor; 
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D sampler1;
uniform sampler2D sampler2;

uniform vec3 yuv_sliders; 

vec3 RgbToYuv(vec3 rgb) {
    // FIX: Explicitly define columns using vec3() for unambiguous construction.
    const mat3 RGB_TO_YUV_MAT = mat3(
        // Column 1 (Y coefficients)
        vec3(0.299, -0.147, 0.615),  // R coefficients for (Y, U, V)
        // Column 2 (U coefficients)
        vec3(0.587, -0.289, -0.515), // G coefficients for (Y, U, V)
        // Column 3 (V coefficients)
        vec3(0.114, 0.436, -0.100)   // B coefficients for (Y, U, V)
    );
    
    // Note: The coefficients have been slightly reordered here to match the 
    // standard (Y, U, V) row structure for R, G, B inputs.
    
    vec3 yuv_components = RGB_TO_YUV_MAT * rgb;

    // Shift U and V from the centered range (around 0.0) to 0.0-1.0 range
    yuv_components.y += 0.5;
    yuv_components.z += 0.5;

    return yuv_components;
}

vec3 YuvToRgb(vec3 yuv) {
    // FIX: Explicitly define columns using vec3()
    const mat3 YUV_TO_RGB_MAT = mat3(
        // Column 1: Y coefficients for (R, G, B)
        vec3(1.0, 1.0, 1.0),
        // Column 2: U coefficients for (R, G, B)
        vec3(0.0, -0.395, 2.032),
        // Column 3: V coefficients for (R, G, B)
        vec3(1.140, -0.581, 0.0)
    );
    
    vec3 yuv_centered = yuv;
    yuv_centered.y -= 0.5;
    yuv_centered.z -= 0.5;
    return YUV_TO_RGB_MAT * yuv_centered;
}

void main(){
    vec4 baseColor = mix(texture(sampler1, retTexCoord), texture(sampler2, retTexCoord), 0.5);
    vec3 yuvBase = RgbToYuv(baseColor.rgb);
    vec3 yuvAdjusted = yuvBase + yuv_sliders;
    yuvAdjusted = clamp(yuvAdjusted, 0.0, 1.0);
    vec3 finalRGB = YuvToRgb(yuvAdjusted);
    FragColor = vec4(finalRGB * retColor, baseColor.a);
}