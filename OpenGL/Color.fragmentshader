#version 330

in vec3 retNormal;
in vec2 retTexCoord;

uniform vec3 LightColor;
uniform vec3 yuv_sliders; // X=Y_Offset, Y=U_Scale, Z=V_Scale

out vec4 FragColor;

// --- YUV Conversion Functions (BT.601 Standard) ---

vec3 RgbToYuv(vec3 rgb) {
    // Rgb to YUV Matrix
    const mat3 RGB_TO_YUV_MAT = mat3(
        vec3(0.299, -0.147, 0.615),
        vec3(0.587, -0.289, -0.515),
        vec3(0.114, 0.436, -0.100)
    );
    
    vec3 yuv_components = RGB_TO_YUV_MAT * rgb;
    
    // Shift U and V from bipolar [-0.5, 0.5] to unipolar [0, 1]
    yuv_components.y += 0.5; 
    yuv_components.z += 0.5;

    return yuv_components;
}

vec3 YuvToRgb(vec3 yuv) {
    // YUV to RGB Inverse Matrix
    const mat3 YUV_TO_RGB_MAT = mat3(
        vec3(1.0, 1.0, 1.0),
        vec3(0.0, -0.395, 2.032),
        vec3(1.140, -0.581, 0.0)
    );
    
    vec3 yuv_centered = yuv;
    
    // Unshift U and V back to bipolar range
    yuv_centered.y -= 0.5;
    yuv_centered.z -= 0.5;
    
    return YUV_TO_RGB_MAT * yuv_centered;
}

// --- Main Fragment Logic ---

void main()
{
    // The base color for the light source cube (fixed white)
    vec3 baseRGB = vec3(1.0f, 1.0f, 1.0f);
    
    // Convert base color to YUV
    vec3 yuvAdjusted = RgbToYuv(baseRGB);

    // 1. Y adjustment (Luminance): Offset (yuv_sliders.x)
    yuvAdjusted.x += yuv_sliders.x;
    
    // 2. U adjustment (Chroma): Multiplier (yuv_sliders.y)
    yuvAdjusted.y -= 0.5;
    yuvAdjusted.y *= yuv_sliders.y; 
    yuvAdjusted.y += 0.5;
    
    // 3. V adjustment (Chroma): Multiplier (yuv_sliders.z)
    yuvAdjusted.z -= 0.5;
    yuvAdjusted.z *= yuv_sliders.z; 
    yuvAdjusted.z += 0.5;

    // Clamp YUV components and convert back to RGB
    yuvAdjusted = clamp(yuvAdjusted, 0.0, 1.0);
    vec3 finalRGB = YuvToRgb(yuvAdjusted);
    
	FragColor = vec4(finalRGB, 1.0f);
}