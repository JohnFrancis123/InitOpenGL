#version 330
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D ScreenTexture;

void main()
{
	//vec3 col = texture(ScreenTexture, retTexCoord).rgb;
	//FragColor = vec4(col, 1.0); // output 1 no effect

	FragColor = vec4(vec3(1.0 - texture(ScreenTexture, retTexCoord)), 1.0); // output 3 invert colors))
}