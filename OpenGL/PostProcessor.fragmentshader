#version 330
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D ScreenTexture;
uniform float frequency;
uniform float amplitude;
uniform float time;
uniform int tintBlue;

void main()
{

    // Use uniforms directly (no unintended scaling) and keep local names for clarity
    float freq = frequency;
    float amp = amplitude;

    // Displace horizontally by sine wave using x * frequency + time as phase
    // Slow down time modulation slightly to reduce rapid changes
    float phase = time * 0.5;
    float offset = sin(retTexCoord.x * freq + phase) * amp;
    vec2 displacedUV = retTexCoord + vec2(offset, 0.0);

    // Wrap horizontally to avoid edge-clamp artifacts that appear to "shrink"
    displacedUV.x = fract(displacedUV.x);
    // Keep vertical within bounds
    displacedUV.y = clamp(displacedUV.y, 0.0, 1.0);

    vec4 col = texture(ScreenTexture, displacedUV);

    if (tintBlue == 1) {
        col.r = col.r * 0.5;
        col.g = col.g * 0.5;
        // b unchanged
    }

    FragColor = col;
}